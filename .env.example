# SIH26074 local demo configuration
AGROMET_DB_PATH=./data/agromet.sqlite3
AGROMET_PANCHAYATS_FILE=./config/panchayats.mock.json
AGROMET_FORECAST_PROVIDER=open_meteo
AGROMET_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
AGROMET_IMD_URL=
AGROMET_AWS_RESIDUAL_URL=
# Leave SRTM unset for the supplied mock demo; terrain is in panchayats.mock.json.
AGROMET_SRTM_PATH=
AGROMET_WATER_POINTS_FILE=
AGROMET_MODEL_ARTIFACT=./agromet/models/m1-telangana-mock-v1/model_bundle.joblib
AGROMET_SCORECARD_FILE=
AGROMET_API_KEY=
PORT=8000


# ---------------------------------------------------------------------------
# Production identity / security
# ---------------------------------------------------------------------------
# Generate a long random value; do not commit the real secret.
AGROMET_SESSION_SECRET=
AGROMET_SESSION_TTL_SECONDS=3600
AGROMET_RATE_LIMIT_PER_MINUTE=600

# Optional first-admin bootstrap. Set only during initial provisioning.
AGROMET_BOOTSTRAP_ADMIN_EMAIL=
AGROMET_BOOTSTRAP_ADMIN_PASSWORD=

# Optional password recovery email delivery.
AGROMET_PUBLIC_BASE_URL=http://127.0.0.1:8000
AGROMET_SMTP_HOST=
AGROMET_SMTP_PORT=587
AGROMET_SMTP_TLS=1
AGROMET_SMTP_USER=
AGROMET_SMTP_PASSWORD=
AGROMET_SMTP_FROM=

# Optional recovery OTP webhook (email/SMS gateway you operate).
# The portal never returns OTP codes when this is configured.
AGROMET_OTP_WEBHOOK_URL=
